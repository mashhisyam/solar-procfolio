APP_NAME=Procfolio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=procfolio
DB_USERNAME=procfolio
DB_PASSWORD=secret

SESSION_DRIVER=file
CACHE_STORE=file
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="procfolio@iconpln.co.id"
MAIL_FROM_NAME="${APP_NAME}"

# --- SSO Microsoft Entra ID (Azure AD) ---
# Kosongkan AZURE_CLIENT_ID untuk memakai login lokal (khusus pengembangan).
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_REDIRECT_URI="${APP_URL}/auth/microsoft/callback"

# --- Procfolio ---
# Login lokal (email + password) hanya untuk pengembangan/UAT bila SSO belum siap.
PROCFOLIO_LOCAL_LOGIN=true
# Domain yang diterima untuk tautan dokumen (pisahkan dengan koma).
PROCFOLIO_LINK_DOMAINS=
# Email yang otomatis menjadi admin saat login pertama (pisahkan dengan koma).
PROCFOLIO_ADMIN_EMAILS=

VITE_APP_NAME="${APP_NAME}"
